<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <RoR2InstallDir Condition="'$(RoR2InstallDir)' == ''">E:\SteamLibrary\steamapps\common\Risk of Rain 2</RoR2InstallDir>
    <RoR2ManagedDir>$(RoR2InstallDir)\Risk of Rain 2_Data\Managed</RoR2ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- MMHOOK is built for Unity's .NET Framework profile; RoR2 loads it under Mono. -->
    <PackageReference Include="MMHOOK.RoR2" Version="2025.12.9" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RoR2">
      <HintPath>$(RoR2ManagedDir)\RoR2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RoR2ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RoR2ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime">
      <HintPath>$(RoR2ManagedDir)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RoR2ManagedDir)\RoR2.dll')"
           Text="Risk of Rain 2 assemblies were not found at '$(RoR2ManagedDir)'. Set RoR2InstallDir to your game installation directory." />
  </Target>

</Project>
